# -----------------------------------------------------------------------------
# Multi-tenant control plane (required for production)
# -----------------------------------------------------------------------------
# Super admin can create/edit/archive tenants at /super-admin/login.
SUPER_ADMIN_PASSWORD=change-this-to-a-long-random-password

# Fernet key used to encrypt every tenant BOT token at rest in SQLite.
# Generate once and keep it forever: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key without re-encrypting rows makes existing tenant tokens unreadable.
ENCRYPTION_KEY=

# Admin panel / persistent data.
PORT=8080
DB_PATH=data/pmshow.db
MEDIA_DIR=media

# Shared Google service-account credentials. Each tenant stores its own
# SPREADSHEET_ID and DRIVE_FOLDER_ID in SQLite via the super-admin panel.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Alternative on Fly: paste the whole JSON service-account key inline.
# GOOGLE_CREDENTIALS_JSON=

# Process-wide registration switches (apply to all tenant bots).
REQUIRE_SUBSCRIPTION=true
REGISTRATION_CLOSED=false

# Optional Telegram user ids allowed to run /diag in a private chat for every
# tenant (comma-separated). The tenant moderation chat is always allowed.
ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Legacy single-bot migration fallback — optional, read only when the SQLite
# database has no tenants table/default "promotors" tenant yet.
# After the first successful start, manage values in /super-admin instead.
# -----------------------------------------------------------------------------
BOT_TOKEN=
REQUIRED_CHANNEL=
ADMIN_CHAT_ID=
CHANNEL_URL=
INSTAGRAM_HANDLE=
INSTAGRAM_URL=
SPREADSHEET_ID=
DRIVE_FOLDER_ID=

# Old panel password. It is copied into promotors as a PBKDF2 tenant password
# during migration. SUPER_ADMIN_PASSWORD is used for the new control plane.
ADMIN_PASSWORD=

# Historic bundled-logo bootstrap (optional; new logos live in tenant media).
LOGO_BASE64=
